#!/usr/bin/env bash
# mc-update prepares the MinIO client (mc) source for an offline build: it fetches a
# pinned commit, raises the Go modules that carry known vulnerabilities, vendors every
# dependency and packs the result into one archive.
set -euo pipefail

VERSION=0.1.0
ROOT=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
LOCK=${MC_UPDATE_LOCK:-$ROOT/sources.lock}
REPOS=${MC_UPDATE_REPOS:-https://github.com/minio/mc https://github.com/MorganKryze/mc}
GO_IMAGE=${MC_UPDATE_GO_IMAGE:-golang:1.27}
GOVULNCHECK=${MC_UPDATE_GOVULNCHECK:-golang.org/x/vuln/cmd/govulncheck@latest}
CACHE=${MC_UPDATE_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/mc-update}

usage() {
	cat <<EOF
mc-update $VERSION: prepare the MinIO client source for an offline build.

Usage:
  mc-update fetch [-c COMMIT | -a ARCHIVE] [-d DIR]
                         get mc into DIR from the repositories, or from ARCHIVE,
                         and check it against sources.lock
  mc-update check [-d DIR]
                         list the vulnerable Go modules in DIR
  mc-update bump  [-d DIR] [MODULE[@VERSION]...]
                         raise modules; with none given, raise each vulnerable
                         module to its first fixed version
  mc-update pack  [-d DIR] [-o OUTDIR]
                         vendor, test the build, write the archive
  mc-update all   [-c COMMIT | -a ARCHIVE] [-d DIR] [-o OUTDIR]
                         fetch, bump and pack in one go

Defaults: COMMIT the last line of sources.lock, DIR mc-src, OUTDIR the current
directory.

Environment:
  MC_UPDATE_REPOS        repositories tried in order ($REPOS)
  MC_UPDATE_LOCK         pinned commits and source hashes ($LOCK)
  MC_UPDATE_GO_IMAGE     Go image used for every Go command ($GO_IMAGE)
  MC_UPDATE_GOVULNCHECK  govulncheck module to run ($GOVULNCHECK)
  MC_UPDATE_CACHE        Go module and build cache ($CACHE)
EOF
}

die() {
	printf 'mc-update: %s\n' "$*" >&2
	exit 1
}

need() {
	command -v "$1" >/dev/null 2>&1 || die "$1 is required"
}

sha256() {
	if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1"; else shasum -a 256 "$1"; fi
}

# go_run DIR CMD... runs CMD in the Go image with DIR mounted at /src. It runs as the
# calling user so the files it writes stay yours, and keeps the Go caches between runs.
go_run() {
	local dir=$1
	shift
	mkdir -p "$CACHE"
	docker run --rm --user "$(id -u):$(id -g)" \
		-v "$(cd "$dir" && pwd):/src" -v "$CACHE:/cache" -w /src \
		-e HOME=/cache -e GOPATH=/cache/go -e GOCACHE=/cache/build -e GOFLAGS=-modcacherw \
		"$GO_IMAGE" "$@"
}

require_source() {
	[ -f "$1/go.mod" ] && [ -f "$1/.mc-update/commit" ] ||
		die "$1 holds no source fetched by mc-update; run: mc-update fetch -d $1"
}

pinned_tree() { awk -v c="$1" '!/^#/ && $1 == c { print $2 }' "$LOCK"; }
pinned_commit() { awk -v t="$1" '!/^#/ && $2 == t { print $1 }' "$LOCK"; }
default_commit() { awk '!/^#/ && NF { c = $1 } END { print c }' "$LOCK"; }

# tree_sha256 DIR hashes the source as the pinned commit holds it: every file path and
# content, symlinks included, with go.mod and go.sum taken from their saved originals.
# vendor/ and .mc-update/ are left out: mc-update writes them.
tree_sha256() {
	# shellcheck disable=SC2016 # expanded by the shell inside the Go image
	go_run "$1" sh -c '
		set -e
		skip="-path ./.git -o -path ./vendor -o -path ./.mc-update"
		{
			find . \( $skip \) -prune -o -type f ! -path ./go.mod ! -path ./go.sum -print0 |
				xargs -0 -r sha256sum
			for f in go.mod go.sum; do
				src=$f
				[ -f .mc-update/$f.orig ] && src=.mc-update/$f.orig
				[ -f "$src" ] && printf "%s  ./%s\n" "$(sha256sum <"$src" | cut -d" " -f1)" "$f"
			done
			find . \( $skip \) -prune -o -type l -printf "link %p %l\n"
		} | LC_ALL=C sort -k2 | sha256sum | cut -d" " -f1'
}

# save_originals DIR keeps the pristine go.mod and go.sum that bump will change.
save_originals() {
	mkdir -p "$1/.mc-update"
	cp "$1/go.mod" "$1/.mc-update/go.mod.orig"
	cp "$1/go.sum" "$1/.mc-update/go.sum.orig"
}

# from_repos COMMIT DIR fetches COMMIT from the first repository that has it.
from_repos() {
	local commit=$1 dir=$2 repo tmp
	need git
	printf '%s\n' "$commit" | grep -qE '^[0-9a-f]{40}$' || die "COMMIT must be a full 40-character hash"
	for repo in $REPOS; do
		tmp=$(mktemp -d "$(dirname "$dir")/.mc-update.XXXXXX")
		if git init --quiet "$tmp" &&
			git -C "$tmp" fetch --quiet --depth 1 "$repo" "$commit" 2>/dev/null &&
			git -C "$tmp" checkout --quiet FETCH_HEAD &&
			[ "$(git -C "$tmp" rev-parse HEAD)" = "$commit" ]; then
			rm -rf "$tmp/.git"
			mv "$tmp" "$dir"
			save_originals "$dir"
			echo "$repo" >"$dir/.mc-update/source"
			return
		fi
		rm -rf "$tmp"
		echo "  $repo: unreachable, or without commit ${commit:0:12}" >&2
	done
	die "no repository in MC_UPDATE_REPOS gave commit ${commit:0:12}"
}

# from_archive ARCHIVE DIR unpacks a tar archive of the mc source, such as one made by
# pack, and brings it back to the pinned state: no vendor/, original go.mod and go.sum.
from_archive() {
	local archive=$1 dir=$2 tmp root entries expected
	[ -f "$archive" ] || die "$archive: no such file"
	if [ -f "$archive.sha256" ]; then
		expected=$(cut -d' ' -f1 "$archive.sha256")
		[ "$(sha256 "$archive" | cut -d' ' -f1)" = "$expected" ] ||
			die "$archive does not match $archive.sha256"
		echo "Archive matches $(basename "$archive").sha256"
	fi

	tmp=$(mktemp -d "$(dirname "$dir")/.mc-update.XXXXXX")
	tar -xf "$archive" -C "$tmp" || {
		rm -rf "$tmp"
		die "$archive: not a tar archive"
	}
	root=$tmp
	entries=$(find "$tmp" -mindepth 1 -maxdepth 1 | wc -l)
	if [ "$entries" -eq 1 ] && [ -d "$(find "$tmp" -mindepth 1 -maxdepth 1)" ]; then
		root=$(find "$tmp" -mindepth 1 -maxdepth 1)
	fi
	[ -f "$root/go.mod" ] || {
		rm -rf "$tmp"
		die "$archive holds no Go module at its top"
	}

	rm -rf "$root/vendor"
	for f in go.mod go.sum; do
		[ -f "$root/.mc-update/$f.orig" ] && cp "$root/.mc-update/$f.orig" "$root/$f"
	done
	local claimed=""
	[ -f "$root/.mc-update/commit" ] && claimed=$(cat "$root/.mc-update/commit")
	rm -rf "$root/.mc-update"
	mv "$root" "$dir"
	rm -rf "$tmp"
	save_originals "$dir"
	echo "archive $(basename "$archive")" >"$dir/.mc-update/source"
	[ -n "$claimed" ] && echo "$claimed" >"$dir/.mc-update/claimed"
	return 0
}

# verify DIR [COMMIT] checks the source tree against sources.lock. With COMMIT, the tree
# must match that commit's pin; without it, the tree must match one of the pins.
verify() {
	local dir=$1 commit=${2:-} tree pinned source
	tree=$(tree_sha256 "$dir")
	source=$(cat "$dir/.mc-update/source")
	if [ -z "$commit" ] && [ -f "$dir/.mc-update/claimed" ]; then
		commit=$(cat "$dir/.mc-update/claimed")
	fi
	if [ -n "$commit" ]; then
		pinned=$(pinned_tree "$commit")
		if [ -z "$pinned" ]; then
			rm -rf "$dir"
			die "commit ${commit:0:12} is not in $LOCK.
It came from $source and its source tree hashes to $tree.
Add this line to sources.lock only if you trust that source:
$commit $tree"
		fi
	else
		commit=$(pinned_commit "$tree")
		pinned=$tree
		if [ -z "$commit" ]; then
			rm -rf "$dir"
			die "the source tree hashes to $tree, which no line of $LOCK pins"
		fi
	fi
	if [ "$tree" != "$pinned" ]; then
		rm -rf "$dir"
		die "the source of ${commit:0:12} differs from its pin in $LOCK.
  expected $pinned
  got      $tree
Refusing it: the source was altered, or fetched incompletely."
	fi
	rm -f "$dir/.mc-update/claimed"
	echo "$commit" >"$dir/.mc-update/commit"
	echo "$tree" >"$dir/.mc-update/tree-sha256"
}

cmd_fetch() {
	local commit="" archive="" dir=mc-src opt
	OPTIND=1
	while getopts c:a:d: opt; do
		case $opt in
		c) commit=$OPTARG ;;
		a) archive=$OPTARG ;;
		d) dir=$OPTARG ;;
		*) die "unknown option; see mc-update help" ;;
		esac
	done
	[ -n "$commit" ] && [ -n "$archive" ] && die "use -c or -a, not both"
	need docker
	[ -f "$LOCK" ] || die "$LOCK not found"
	[ -e "$dir" ] && die "$dir already exists; remove it or pick another with -d"
	mkdir -p "$(dirname "$dir")"

	if [ -n "$archive" ]; then
		from_archive "$archive" "$dir"
		verify "$dir"
	else
		commit=${commit:-$(default_commit)}
		from_repos "$commit" "$dir"
		verify "$dir" "$commit"
	fi
	echo "Fetched mc $(cut -c1-12 "$dir/.mc-update/commit") from $(cat "$dir/.mc-update/source") into $dir"
	echo "Source matches sources.lock (tree sha256 $(cut -c1-16 "$dir/.mc-update/tree-sha256")...)"
}

# vulnerable_modules DIR prints one line per finding: module, version in use, first
# fixed version, advisory id. -scan module reports every advisory on a required module,
# as image scanners do, not only the ones whose code mc calls.
vulnerable_modules() {
	go_run "$1" go run "$GOVULNCHECK" -scan module -format json |
		jq -r 'select(.finding) | .finding
		| [.trace[0].module, (.trace[0].version // "-"), (.fixed_version // "none"), .osv] | @tsv' |
		sort -u
}

cmd_check() {
	local dir=mc-src opt findings
	OPTIND=1
	while getopts d: opt; do
		case $opt in
		d) dir=$OPTARG ;;
		*) die "unknown option; see mc-update help" ;;
		esac
	done
	need docker
	need jq
	require_source "$dir"

	findings=$(vulnerable_modules "$dir")
	if [ -z "$findings" ]; then
		echo "No known vulnerability in the modules of $dir."
		return
	fi
	{
		printf 'MODULE\tIN USE\tFIXED IN\tADVISORY\n'
		printf '%s\n' "$findings"
	} | column -t -s "$(printf '\t')"
	if printf '%s\n' "$findings" | cut -f1 | grep -qx stdlib; then
		echo
		echo "stdlib findings come from the Go version that builds mc: build with a newer Go image."
	fi
}

# fix_targets DIR prints module@version for each vulnerable module: the highest of its
# first fixed versions, the smallest raise that clears every advisory known on it.
fix_targets() {
	vulnerable_modules "$1" |
		awk -F'\t' '$1 != "stdlib" && $3 != "none" { print $1 "\t" $3 }' |
		sort -t "$(printf '\t')" -k1,1 -k2,2V |
		awk -F'\t' '{ last[$1] = $2 } END { for (m in last) print m "@" last[m] }' |
		sort | tr '\n' ' '
}

# raise DIR TARGET... raises one module at a time, and only upward: raising x/net can
# already pull x/sys past its own target, and asking for that lower target would pull
# x/net back down.
raise() {
	local dir=$1
	shift
	# shellcheck disable=SC2016 # $ expands inside the Go image
	go_run "$dir" sh -c '
		set -e
		for target in "$@"; do
			case $target in
			*@*) module=${target%@*} want=${target#*@} ;;
			*) module=$target want=latest ;;
			esac
			have=$(go list -m -f "{{.Version}}" "$module")
			if [ "$want" = latest ]; then
				raise=yes
			elif [ "$have" != "$want" ] && [ "$(printf "%s\n%s\n" "$have" "$want" | sort -V | head -n1)" = "$have" ]; then
				raise=yes
			else
				raise=no
			fi
			if [ $raise = yes ]; then
				echo "  $module $have -> $want"
				go get "$module@$want"
			else
				echo "  $module $have already covers $want"
			fi
		done
		go mod tidy' sh "$@"
}

cmd_bump() {
	local dir=mc-src opt targets previous="" pass
	OPTIND=1
	while getopts d: opt; do
		case $opt in
		d) dir=$OPTARG ;;
		*) die "unknown option; see mc-update help" ;;
		esac
	done
	shift $((OPTIND - 1))
	need docker
	require_source "$dir"

	if [ $# -gt 0 ]; then
		echo "Raising modules in $dir:"
		raise "$dir" "$@"
	else
		need jq
		# A module can carry fixes on several release lines: once raised to v1.83.1, the
		# fix it needs may be v1.83.2. Scan again until nothing is left or nothing moves.
		for pass in 1 2 3 4 5; do
			targets=$(fix_targets "$dir")
			if [ -z "${targets// /}" ]; then
				[ "$pass" = 1 ] && echo "Nothing to raise in $dir."
				break
			fi
			if [ "$targets" = "$previous" ]; then
				echo "Stopped: these modules have no newer fix: $targets"
				break
			fi
			echo "Raising modules in $dir (pass $pass):"
			# shellcheck disable=SC2086 # one word per module
			raise "$dir" $targets
			previous=$targets
		done
	fi

	echo
	echo "Changes to go.mod:"
	{ diff "$dir/.mc-update/go.mod.orig" "$dir/go.mod" || true; } |
		sed -n 's/^< /  - /p; s/^> /  + /p' | tr -d '\t' | grep -v '^  [-+] *$' || echo "  none"
}

cmd_pack() {
	local dir=mc-src out=. opt commit name archive
	OPTIND=1
	while getopts d:o: opt; do
		case $opt in
		d) dir=$OPTARG ;;
		o) out=$OPTARG ;;
		*) die "unknown option; see mc-update help" ;;
		esac
	done
	need docker
	require_source "$dir"
	mkdir -p "$out"

	# Only go.mod and go.sum may change between fetch and pack.
	[ "$(tree_sha256 "$dir")" = "$(cat "$dir/.mc-update/tree-sha256")" ] ||
		die "$dir changed since fetch beyond go.mod and go.sum; fetch it again"

	echo "Vendoring and test build with $GO_IMAGE..."
	go_run "$dir" sh -c '
		set -e
		go mod tidy
		go mod vendor
		CGO_ENABLED=0 go build -mod=vendor -trimpath -o /tmp/mc .
		/tmp/mc --version >/dev/null
		go version | cut -d" " -f3 > .mc-update/go-build
		sed -n "s/^go //p" go.mod > .mc-update/go-min'
	diff "$dir/.mc-update/go.mod.orig" "$dir/go.mod" >"$dir/.mc-update/changes" || true
	echo "$GO_IMAGE" >"$dir/.mc-update/go-image"

	commit=$(cut -c1-12 "$dir/.mc-update/commit")
	name="mc-$commit-$(date -u +%Y%m%d)"
	archive="$out/$name.tar.gz"
	tar -czf "$archive" -C "$(dirname "$dir")" "$(basename "$dir")"
	(cd "$out" && sha256 "$name.tar.gz") >"$archive.sha256"

	echo
	echo "Archive: $archive ($(du -h "$archive" | awk '{print $1}'))"
	echo "SHA-256: $(cut -d' ' -f1 "$archive.sha256")"
	echo "Needs Go $(cat "$dir/.mc-update/go-min") or later to build; tested with $(cat "$dir/.mc-update/go-build")."
	echo
	echo "Next: move both files to the offline side and build with docker/Dockerfile."
}

cmd_all() {
	local commit="" archive="" dir=mc-src out=. opt
	OPTIND=1
	while getopts c:a:d:o: opt; do
		case $opt in
		c) commit=$OPTARG ;;
		a) archive=$OPTARG ;;
		d) dir=$OPTARG ;;
		o) out=$OPTARG ;;
		*) die "unknown option; see mc-update help" ;;
		esac
	done
	if [ -n "$archive" ]; then
		[ -n "$commit" ] && die "use -c or -a, not both"
		cmd_fetch -a "$archive" -d "$dir"
	elif [ -n "$commit" ]; then
		cmd_fetch -c "$commit" -d "$dir"
	else
		cmd_fetch -d "$dir"
	fi
	echo
	cmd_bump -d "$dir"
	echo
	cmd_pack -d "$dir" -o "$out"
}

case ${1:-help} in
fetch | check | bump | pack | all)
	cmd=$1
	shift
	"cmd_$cmd" "$@"
	;;
version | --version) echo "mc-update $VERSION" ;;
help | -h | --help) usage ;;
*)
	usage >&2
	exit 2
	;;
esac
